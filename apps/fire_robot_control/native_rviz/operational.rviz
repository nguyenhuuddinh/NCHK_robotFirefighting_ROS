Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Enabled: true
  Global Options:
    Background Color: 110; 110; 110
    Fixed Frame: map
    Frame Rate: 10
  Name: root
  Displays:
    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Enabled: false
      Value: false
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
      Description Topic:
        Value: /robot_description
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      TF Prefix: ""
    - Class: rviz_default_plugins/Path
      Name: Nav2 Plan
      Enabled: false
      Value: false
      Alpha: 0.9
      Color: 0; 155; 210
      Buffer Length: 1
      Line Style: Billboards
      Line Width: 0.035
      Pose Style: None
      Topic:
        Value: /plan
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Value: true
      Alpha: 1
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /map
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Value: true
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 50; 50
      Topic:
        Value: /scan
        Depth: 1
        Filter size: 2
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Value: false
      Show Names: false
      Frame Timeout: 1
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 100
      Target Frame: <Fixed Frame>
      X: 0
      Y: 0
Window Geometry:
  Width: 1400
  Height: 800
  Hide Left Dock: true
  Hide Right Dock: true
