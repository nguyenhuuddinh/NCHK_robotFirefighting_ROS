<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fire_robot">

  <!-- ============================================================== -->
  <!--  THÔNG SỐ KÍCH THƯỚC (từ Tai_Lieu_So_7_Kich_Thuoc_Robot.md)   -->
  <!--  Đơn vị: mét (m), radian (rad)                                -->
  <!-- ============================================================== -->

  <!-- Khung xe -->
  <xacro:property name="chassis_length"   value="0.255"/>
  <xacro:property name="chassis_width"    value="0.150"/>
  <xacro:property name="chassis_height"   value="0.052"/>
  <xacro:property name="ground_clearance" value="0.065"/>

  <!-- Bánh xe -->
  <xacro:property name="wheel_radius"  value="0.034"/>
  <xacro:property name="wheel_width"   value="0.026"/>
  <xacro:property name="track_width"   value="0.180"/>
  <xacro:property name="wheelbase"     value="0.134"/>

  <!-- Vị trí cảm biến (Z = ground_clearance + Z_đo_từ_đáy_xe) -->
  <xacro:property name="lidar_x"  value="0.094"/>
  <xacro:property name="lidar_z"  value="0.183"/>  <!-- 6.5 + 11.8 = 18.3cm -->

  <xacro:property name="camera_x"     value="0.1275"/>
  <xacro:property name="camera_z"     value="0.128"/>  <!-- 6.5 + 6.3 = 12.8cm -->
  <xacro:property name="camera_pitch" value="0.07"/>   <!-- ~4 độ nghiêng xuống -->

  <xacro:property name="imu_x"  value="0.016"/>
  <xacro:property name="imu_y"  value="-0.005"/>
  <xacro:property name="imu_z"  value="0.075"/>  <!-- 6.5 + 1.0 = 7.5cm -->

  <!-- ============================================================== -->
  <!--  BASE LINK (tâm xe, trên mặt đất Z=0)                         -->
  <!-- ============================================================== -->
  <link name="base_link"/>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================== -->
  <!--  CHASSIS (khung xe hình hộp)                                   -->
  <!-- ============================================================== -->
  <link name="chassis_link">
    <visual>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.25 0.25 0.25 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
  </link>
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin xyz="0 0 ${ground_clearance + chassis_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================== -->
  <!--  BÁNH XE (4 bánh, visual only, fixed joints)                   -->
  <!-- ============================================================== -->
  <xacro:macro name="wheel" params="name x_pos y_pos">
    <link name="${name}_wheel_link">
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
    </link>
    <joint name="${name}_wheel_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <!-- Cylinder mặc định dọc Z, xoay pi/2 quanh X để nằm ngang -->
      <origin xyz="${x_pos} ${y_pos} ${wheel_radius}" rpy="${pi/2} 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="front_left"  x_pos="${wheelbase/2}"  y_pos="${track_width/2}"/>
  <xacro:wheel name="rear_left"   x_pos="${-wheelbase/2}" y_pos="${track_width/2}"/>
  <xacro:wheel name="front_right" x_pos="${wheelbase/2}"  y_pos="${-track_width/2}"/>
  <xacro:wheel name="rear_right"  x_pos="${-wheelbase/2}" y_pos="${-track_width/2}"/>

  <!-- ============================================================== -->
  <!--  CỘT ĐỠ LIDAR (pole visual)                                   -->
  <!-- ============================================================== -->
  <xacro:property name="pole_height" value="${lidar_z - ground_clearance - chassis_height}"/>
  <link name="lidar_pole_link">
    <visual>
      <geometry>
        <cylinder radius="0.008" length="${pole_height}"/>
      </geometry>
      <material name="silver">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="lidar_pole_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_pole_link"/>
    <origin xyz="${lidar_x} 0 ${ground_clearance + chassis_height + pole_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================== -->
  <!--  LIDAR (laser_frame — quét ngang)                              -->
  <!-- ============================================================== -->
  <link name="laser_frame">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.020"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="${lidar_x} 0 ${lidar_z}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================== -->
  <!--  CAMERA (camera_frame — nhìn thẳng, nghiêng xuống ~4°)         -->
  <!-- ============================================================== -->
  <link name="camera_frame">
    <visual>
      <geometry>
        <box size="0.025 0.060 0.025"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.1 0.8 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_frame"/>
    <origin xyz="${camera_x} 0 ${camera_z}" rpy="0 ${camera_pitch} 0"/>
  </joint>

  <!-- Camera optical frame (chuẩn ROS: Z forward, X right, Y down) -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_frame"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- ============================================================== -->
  <!--  IMU (imu_frame)                                               -->
  <!-- ============================================================== -->
  <link name="imu_frame">
    <visual>
      <geometry>
        <box size="0.020 0.020 0.005"/>
      </geometry>
      <material name="green">
        <color rgba="0.1 0.8 0.1 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_frame"/>
    <origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="0 0 0"/>
  </joint>

</robot>
