#lệnh tắt all node trên pi

ssh pi@10.42.0.185 'bash -s' <<'PI_STOP'
pkill -INT -f '[r]5_pi_session.py' || true
sleep 8

nodes='[r]5_pi_session.py|[s]erial_bridge_node|[s]afety_watchdog|[c]amsense_x1_node|[n]ative_mjpeg_camera|[o]dom_to_tf_broadcaster|[s]can_qos_relay|[r]osbridge_websocket|[r]obot_state_publisher'

pkill -INT -f "$nodes" || true
sleep 3
pkill -TERM -f "$nodes" || true
sleep 2

pgrep -af "$nodes" || echo 'PI_ROBOT_NODES_STOPPED'
PI_STOP		#Thấy PI_ROBOT_NODES_STOPPED là các tiến trình trong danh sách đã tắt

#lệnh động bộ khi sài wifi

PI_ADDR=10.0.0.1
LAPTOP_ADDR=10.0.0.253

ssh -t pi@"$PI_ADDR" \
  "sudo chronyc online $LAPTOP_ADDR && \
   sudo chronyc burst 4/4 $LAPTOP_ADDR && \
   chronyc waitsync 30 0.02 0 2 && \
   chronyc -n tracking && chronyc -n sources"

#lệnh đồng bộ time khi sài lan

PI_ADDR=10.42.0.185
LAPTOP_ADDR=10.42.0.1

ssh -t pi@"$PI_ADDR" \
  "sudo chronyc online $LAPTOP_ADDR && \
   sudo chronyc burst 4/4 $LAPTOP_ADDR && \
   chronyc waitsync 30 0.02 0 2 && \
   chronyc -n tracking && chronyc -n sources"


